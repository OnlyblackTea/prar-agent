# Application
APP_NAME=prar-agent-backend
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://prar:prar@localhost:15432/prar_agent

# LLM (Task 4.1 起 model adapter 体系上线后会替换 DEFAULT_MODEL_ID)
DEFAULT_MODEL_ID=claude-sonnet-4-6

# LLM provider API keys（anthropic / openai SDK 直接读取）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
